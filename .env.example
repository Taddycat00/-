# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PostgreSQL Database Connection (Supports Neon, Supabase, Cloud SQL, AWS RDS, etc.)
# Format: postgresql://username:password@ep-example.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Alternatively, individual PG credentials:
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSL=true
