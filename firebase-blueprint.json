{
  "entities": {
    "Customer": {
      "title": "Customer",
      "description": "客戶資料",
      "type": "object",
      "properties": {
        "customerId": { "type": "string", "description": "客戶唯一編號 Cxxx" },
        "companyName": { "type": "string", "description": "公司名稱" },
        "contactPerson": { "type": "string", "description": "聯絡人姓名" },
        "englishName": { "type": "string", "description": "英文名稱" },
        "department": { "type": "string", "description": "部門名稱" },
        "jobTitle": { "type": "string", "description": "職稱" },
        "phone": { "type": "string", "description": "電話號碼" },
        "email": { "type": "string", "description": "電子郵件" },
        "taxId": { "type": "string", "description": "統一編號" },
        "address": { "type": "string", "description": "地址" },
        "paymentTerms": { "type": "string", "description": "付款條件" },
        "notes": { "type": "string", "description": "備註" },
        "updatedAt": { "type": "string", "description": "更新時間戳記" }
      },
      "required": ["customerId", "companyName"]
    },
    "Vendor": {
      "title": "Vendor",
      "description": "廠商資料",
      "type": "object",
      "properties": {
        "vendorId": { "type": "string", "description": "廠商唯一編號 Vxxx" },
        "companyName": { "type": "string", "description": "公司名稱" },
        "contactPerson": { "type": "string", "description": "聯絡人姓名" },
        "englishName": { "type": "string", "description": "英文名稱" },
        "department": { "type": "string", "description": "部門名稱" },
        "jobTitle": { "type": "string", "description": "職稱" },
        "phone": { "type": "string", "description": "電話號碼" },
        "email": { "type": "string", "description": "電子郵件" },
        "taxId": { "type": "string", "description": "統一編號" },
        "address": { "type": "string", "description": "地址" },
        "paymentTerms": { "type": "string", "description": "付款條件" },
        "notes": { "type": "string", "description": "備註" },
        "updatedAt": { "type": "string", "description": "更新時間戳記" }
      },
      "required": ["vendorId", "companyName"]
    },
    "Product": {
      "title": "Product",
      "description": "產品資料",
      "type": "object",
      "properties": {
        "productId": { "type": "string", "description": "產品唯一編號 Pxxx" },
        "productName": { "type": "string", "description": "產品名稱" },
        "cost": { "type": "number", "description": "成本價" },
        "price": { "type": "number", "description": "銷售價" },
        "unit": { "type": "string", "description": "單位" },
        "imageUrl": { "type": "string", "description": "產品圖片網址" },
        "brand": { "type": "string", "description": "品牌名稱" },
        "spec": { "type": "string", "description": "規格描述" },
        "description": { "type": "string", "description": "產品說明" },
        "stockQty": { "type": "number", "description": "庫存數量" },
        "vendorId": { "type": "string", "description": "所屬廠商編號" },
        "notes": { "type": "string", "description": "備註" },
        "updatedAt": { "type": "string", "description": "更新時間戳記" }
      },
      "required": ["productId", "productName", "cost", "price", "unit"]
    },
    "Quote": {
      "title": "Quote",
      "description": "報價單資料",
      "type": "object",
      "properties": {
        "quoteId": { "type": "string", "description": "報價單唯一編號 Qxxx" },
        "customerId": { "type": "string", "description": "客戶編號" },
        "quoteStaff": { "type": "string", "description": "報價人員" },
        "contactPhone": { "type": "string", "description": "聯絡電話" },
        "contactAddress": { "type": "string", "description": "聯絡地址" },
        "quoteDate": { "type": "string", "description": "報價日期 YYYY-MM-DD" },
        "validityDate": { "type": "string", "description": "有效日期 YYYY-MM-DD" },
        "notes": { "type": "string", "description": "備註" },
        "items": { "type": "array", "description": "報價品項清單" },
        "totalAmount": { "type": "number", "description": "報價總金額" },
        "updatedAt": { "type": "string", "description": "更新時間戳記" }
      },
      "required": ["quoteId", "customerId", "quoteDate", "items", "totalAmount"]
    }
  },
  "firestore": {
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "客戶資料集合"
    },
    "/vendors/{vendorId}": {
      "schema": { "$ref": "#/entities/Vendor" },
      "description": "廠商資料集合"
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "產品資料集合"
    },
    "/quotes/{quoteId}": {
      "schema": { "$ref": "#/entities/Quote" },
      "description": "報價單資料集合"
    }
  }
}
